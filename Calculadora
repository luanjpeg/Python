def somar(num, num2):
    return num + num2

def subtrair(num, num2):
    return num - num2

def multiplicar(num, num2):
    return num * num2

def dividir(num, num2):
    if num2 == 0:
        return ZeroDivisionError ("Não é Possível Dividir por Zero")
    return num // num2
    

op = ""
